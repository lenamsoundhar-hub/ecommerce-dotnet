{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }

  // ConnectionStrings:DefaultConnection is deliberately absent. Supply it from
  // user secrets, which are stored outside the repository and override this file:
  //
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<connection string>" --project eCommerce/src/eCommerce.Api
  //
  // Never commit a connection string that carries credentials.
}
